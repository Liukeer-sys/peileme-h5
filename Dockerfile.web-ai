FROM node:22-alpine AS builder
WORKDIR /app
ARG VITE_SHARE_URL
ENV VITE_SHARE_URL=$VITE_SHARE_URL
COPY package.json package-lock.json ./
RUN npm ci
COPY ai.html tsconfig.json vite.ai.config.ts vite.product-boundary.ts product-boundary-markers.ts ./
COPY public-ai ./public-ai
COPY src ./src
RUN npm run build:web:ai

FROM nginx:1.27-alpine
COPY deploy/nginx-ai.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist-ai /usr/share/nginx/html
EXPOSE 80
