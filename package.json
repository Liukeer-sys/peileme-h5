{
  "name": "peileme-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.main.config.ts",
    "dev:web:ai": "vite --config vite.ai.config.ts",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web:main": "tsc && vite build --config vite.main.config.ts",
    "build:web:ai": "tsc && vite build --config vite.ai.config.ts",
    "build:web": "npm run build:web:main && npm run build:web:ai && npm run verify:web:artifacts",
    "verify:web:artifacts": "tsx scripts/verify-web-artifacts.ts",
    "build:api": "tsc -p server/tsconfig.json && tsc -p tsconfig.scripts.json",
    "start:api": "node server-dist/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "db:import:regions": "tsx scripts/import-administrative-regions.ts",
    "db:import:parameters": "tsx scripts/import-regional-parameters.ts",
    "test": "vitest run",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down --volumes",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:watch": "vitest",
    "test:e2e:production": "playwright test",
    "test:e2e:dual-compose": "node scripts/run-dual-web-compose-e2e.mjs",
    "preview": "vite preview --config vite.main.config.ts",
    "preview:web:ai": "vite preview --config vite.ai.config.ts"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.0.12",
    "motion": "^12.42.2",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
