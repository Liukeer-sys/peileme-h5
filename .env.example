POSTGRES_DB=peileme
POSTGRES_USER=peileme
POSTGRES_PASSWORD=generate-a-long-random-password
WEB_MAIN_PORT=18083
WEB_AI_PORT=18084
VITE_MAIN_URL=https://peileme.art/
VITE_AI_URL=https://ai.peileme.art/
APP_ORIGIN=https://peileme.art,https://www.peileme.art,https://ai.peileme.art
MAIN_PRODUCT_HOSTS=peileme.art,www.peileme.art
AI_PRODUCT_HOSTS=ai.peileme.art
MAIN_APP_ORIGIN=https://peileme.art
AI_APP_ORIGIN=https://ai.peileme.art
COOKIE_DOMAIN=.peileme.art
TRUST_PROXY=2
JWT_SECRET=generate-at-least-32-random-characters
OTP_SECRET=generate-at-least-32-random-characters
CSRF_SECRET=generate-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_DEBUG=false
REGISTRATION_REQUIRE_INVITE=false
MAX_UPLOAD_MB=10
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=generate-a-strong-admin-password
BOOTSTRAP_INVITE_CODE=generate-a-private-bootstrap-invite

# AI Provider fallback chain（与 OranMemory 对齐：同 Provider 重试，再切换 Provider）
LLM_PRIMARY=tuzi
LLM_TUZI_BASE_URL=https://api.tu-zi.com
LLM_TUZI_API_KEY=
LLM_TUZI_MODEL=gpt-5.4
LLM_DATAEYES_BASE_URL=https://cloud.dataeyes.ai
LLM_DATAEYES_API_KEY=
LLM_DATAEYES_MODEL=gemini-2.5-pro
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_MS=800
LLM_REQUEST_TIMEOUT_MS=90000
AI_WORKER_POLL_MS=500
AI_WORKER_LEASE_SECONDS=180
AI_WORKER_MAX_ATTEMPTS=2
AI_WORKER_RETRY_DELAY_MS=5000

# 按次支付。商户资料审核完成前保持 disabled。
PAYMENT_MODE=disabled
PAYMENT_PROVIDERS=
PAYMENT_NOTIFY_ORIGIN=https://peileme.art

# 微信支付 APIv3 H5（启用 wechat_h5 时全部必填）
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/wechat_private_key.pem
WECHAT_PAY_API_V3_KEY_FILE=/run/secrets/wechat_api_v3_key
WECHAT_PAY_PUBLIC_KEYS_FILE=/run/secrets/wechat_public_keys.json

# 支付宝 WAP（启用 alipay_wap 时全部必填）
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_public_key.pem

# 文件由 secret manager 以只读权限挂载。也可清空对应 *_FILE，改用
# *_SECRET_REF=env:VARIABLE_NAME 引用进程环境中的 secret；引用值本身不会进入配置对象。

# 邮件验证码（任选邮件服务商的 SMTP）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 阿里云邮件推送（配置后优先于 SMTP）
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=noreply@peileme.art

# 阿里云短信验证码
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
