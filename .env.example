# 邮件验证码（任选邮件服务商的 SMTP）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 阿里云邮件推送（配置后优先于 SMTP）
