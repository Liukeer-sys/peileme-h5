POSTGRES_PASSWORD=generate-a-long-random-password
WEB_PORT=18083
VITE_SHARE_URL=https://peileme.art/
APP_ORIGIN=https://peileme.art,https://www.peileme.art
TRUST_PROXY=2
JWT_SECRET=generate-at-least-32-random-characters
OTP_SECRET=generate-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_DEBUG=false
REGISTRATION_REQUIRE_INVITE=false
MAX_UPLOAD_MB=10
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=generate-a-strong-admin-password
